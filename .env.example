# ---------------------------------------------------------------------------
# Vibe Then Build configuration. Copy to .env and edit.
#
# The default configuration runs entirely on your own machine with Ollama and
# costs nothing to operate. No cloud API key is required for the system to
# work end to end.
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://vtb:loop@localhost:5432/vibe_then_build

# Inference gateway. Points at LiteLLM, which fronts Ollama by default.
#
# LLM_GATEWAY_KEY and LITELLM_MASTER_KEY must be set to the exact same value.
# The gateway (litellm.config.yaml, general_settings.master_key) rejects any
# request that does not present this value as its bearer token; Vibe Then Build
# sends LLM_GATEWAY_KEY as that bearer token (src/lib/ai/router.ts). Generate
# one random value and paste it into both lines below:
#   openssl rand -hex 32
# Leaving these unset, or leaving them mismatched, means the gateway either
# refuses every request or accepts none with the token Vibe Then Build sends — set
# both before running `docker compose up -d`.
LLM_GATEWAY_URL=http://localhost:4000
LLM_GATEWAY_KEY=
LITELLM_MASTER_KEY=

# Local models, by job. These are the shipped defaults; any Ollama tag works.
MODEL_DRAFTING=ollama/qwen3:14b
MODEL_CLASSIFY=ollama/qwen3:4b
MODEL_ENRICH=ollama/qwen3:4b
MODEL_EMBED=ollama/nomic-embed-text

# Optional frontier escalation. Leave blank to stay fully local.
# When blank, any task routed to "hard" falls back to MODEL_DRAFTING and the
# fallback is written to the action log so you can see where quality was capped.
ANTHROPIC_API_KEY=
MODEL_HARD=

# Global kill switch. When true, no outbound action of any kind may send,
# regardless of per-action policy. Flip this first if something goes wrong.
LOOP_KILL_SWITCH=false

# Operator timezone, used for quiet-hours enforcement.
OPERATOR_TZ=America/Denver

# ---------------------------------------------------------------------------
# Optional integrations. Vibe Then Build composes with existing open-source tools
# at the process boundary rather than merging their source; see
# docs/integrations.md for the full reasoning. Every setting below is
# optional. Leave it unset and the corresponding capability is simply
# unavailable — nothing else in the system is affected.
# ---------------------------------------------------------------------------

# Postiz, for publishing to social platforms. Leave both unset and
# `linkedin.post` stays unavailable; everything else runs normally. Get the
# API key from a running Postiz instance under Settings -> Public API.
POSTIZ_URL=
POSTIZ_API_KEY=

# OpenOutreach, for lead discovery. Run it as its own process and point this
# at the directory where it writes its CSV export; Vibe Then Build reads from
# that directory and never runs OpenOutreach itself. Leave it unset and lead
# import from OpenOutreach stays unavailable; everything else runs normally.
OPENOUTREACH_EXPORT_DIR=

# Largest export the OpenOutreach adapter will read, in bytes. Optional;
# defaults to 64 MB. Raise it only if your exports legitimately run larger,
# since the whole file is held in memory while it is parsed.
OPENOUTREACH_MAX_CSV_BYTES=
